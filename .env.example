# ─────────────────────────────────────────────────────────────────────────
# FINO – Tink Open Banking (Sandbox)
# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# WICHTIG: ".env" niemals committen (steht in .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# CLIENT-SEITIG (landet im App-Bundle, daher EXPO_PUBLIC_ Prefix)
# Wo finden? -> console.tink.com -> deine App -> "App settings" -> "Client ID"
# Die Client ID ist öffentlich und darf in der App stehen.
EXPO_PUBLIC_TINK_CLIENT_ID=dein_tink_client_id

# Supabase Edge Function URL (für den Token-Austausch).
# Wo finden? -> Supabase Dashboard -> Project Settings -> API -> Project URL
# Daraus wird: https://<project-ref>.functions.supabase.co/tink-token-exchange
EXPO_PUBLIC_SUPABASE_FUNCTIONS_URL=https://ylcccbcbznqvxogujeij.functions.supabase.co

# ─────────────────────────────────────────────────────────────────────────
# SERVER-SEITIG (NUR in der Supabase Edge Function, NIE im App-Bundle!)
# Diese Werte werden via "supabase secrets set" gesetzt, nicht hier geladen.
# Wo finden? -> console.tink.com -> deine App -> "App settings" -> "Client secret"
#   (nur einmal beim Erstellen sichtbar; sonst neu generieren)
# Setzen mit:
#   supabase secrets set TINK_CLIENT_ID=... TINK_CLIENT_SECRET=... TOKEN_ENCRYPTION_KEY=...
#
# TOKEN_ENCRYPTION_KEY verschlüsselt den gespeicherten Tink refresh_token
# (AES-GCM). 32 zufällige Bytes als base64 generieren mit:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────
TINK_CLIENT_ID=dein_tink_client_id
TINK_CLIENT_SECRET=dein_tink_client_secret
TOKEN_ENCRYPTION_KEY=base64_von_32_zufaelligen_bytes
